# Copie para .env e preencha. NUNCA faça commit do .env.

# Do portal developers.tiktok.com > seu app > Credentials
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Precisa ser idêntico ao cadastrado no Login Kit do app
TIKTOK_REDIRECT_URI=https://seudominio.com.br/tiktok/callback

# URL pública onde ficam as imagens (prefixo/domínio verificado no portal do TikTok).
# Arquivo posts/<pasta>/01.jpg vira PUBLIC_BASE_URL/<pasta>/01.jpg
PUBLIC_BASE_URL=https://seudominio.com.br/carrosseis

# Opcional: escopos pedidos na autorização
# TIKTOK_SCOPES=user.info.basic,video.publish,video.upload
